{
	"name": "@lickybuay/builderdash",
	"version": "0.1.0",
	"description": "Visual page builder for EmDash — Elementor-style board, widget panel and inspector.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lickybuay/builderdash.git"
	},
	"homepage": "https://github.com/lickybuay/builderdash#readme",
	"bugs": {
		"url": "https://github.com/lickybuay/builderdash/issues"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./admin": "./src/editor/index.tsx",
		"./astro": "./src/render/index.ts",
		"./BuilderLayout.astro": "./src/render/BuilderLayout.astro",
		"./TemplatePart.astro": "./src/render/TemplatePart.astro",
		"./parts": "./src/render/parts.ts",
		"./classes": "./src/render/classes.ts",
		"./edit-mode": "./src/render/edit-mode.ts"
	},
	"bin": {
		"builderdash-setup": "./install.sh"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"README.md",
		"LICENSE",
		"emdash-plugin.jsonc",
		"install.sh",
		"templates"
	],
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts --clean",
		"dev": "tsdown src/index.ts --format esm --dts --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"peerDependencies": {
		"@cloudflare/kumo": "*",
		"@emdash-cms/admin": "*",
		"@lingui/core": "*",
		"@lingui/react": "*",
		"@tanstack/react-query": "*",
		"astro": ">=6.0.0-beta.0",
		"emdash": "*",
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^30.1.1",
		"tsdown": "^0.20.0",
		"typescript": "^5.9.0",
		"vitest": "^5.0.2"
	},
	"keywords": [
		"emdash",
		"emdash-plugin",
		"builder",
		"page-builder"
	],
	"license": "MIT"
}
