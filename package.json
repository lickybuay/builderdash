{
	"name": "@emdash/builderdash",
	"version": "0.1.0",
	"description": "Visual page builder for EmDash — Elementor-style board, widget panel and inspector.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lickybuay/builderdash.git",
		"directory": "plugin-builderdash"
	},
	"homepage": "https://github.com/lickybuay/builderdash#readme",
	"bugs": {
		"url": "https://github.com/lickybuay/builderdash/issues"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./admin": "./src/editor/index.tsx",
		"./astro": "./src/render/index.ts"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"README.md",
		"LICENSE",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts --clean",
		"dev": "tsdown src/index.ts --format esm --dts --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "npm run build"
	},
	"peerDependencies": {
		"@cloudflare/kumo": "*",
		"@emdash-cms/admin": "*",
		"@lingui/core": "*",
		"@lingui/react": "*",
		"@tanstack/react-query": "*",
		"astro": ">=6.0.0-beta.0",
		"emdash": "*",
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^30.1.1",
		"tsdown": "^0.20.0",
		"typescript": "^5.9.0",
		"vitest": "^5.0.2"
	},
	"keywords": [
		"emdash",
		"emdash-plugin",
		"builder",
		"page-builder"
	],
	"license": "MIT"
}
