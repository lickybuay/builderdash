---
/**
 * Public render of a builder layout.
 *
 * Draws the tree stored in `builder_layout` with the HOST SITE's components:
 * the plugin knows the structure, the site knows what its content blocks look
 * like. The site header and footer belong to the whole site, not to the page:
 * they always wrap the layout and the builder never moves them.
 *
 *   <BuilderLayout
 *     layout={page.data.builder_layout}
 *     content={page.data.content}
 *     header={SiteHeader}
 *     footer={SiteFooter}
 *     blocks={MarketingBlocks}   // renders `value={[block]}`
 *   />
 *
 * Every node is wrapped in a `display: contents` element carrying
 * `data-bd-key`, so the editor can find, select and reorder it inside the live
 * preview without the wrapper changing the page's layout.
 *
 * A content block the layout does not reference is still rendered (appended),
 * so a block added in the EmDash editor never silently disappears.
 *
 * <main> carries `class="builderdash"` and, with `entry`, the entry as data
 * attributes for CSS: `[data-bd-id="…"]`, `[data-bd-slug="…"]`,
 * `[data-bd-collection="…"]`. The site puts `page-<id>` on <body> with
 * `bodyClasses` (see `classes.ts`).
 */

import { deserializeEntry, type StoredBlock, type StoredStyles } from "../editor/store/serialize";
import type { BuilderTree } from "../editor/store/tree";
import BuilderNode from "./BuilderNode.astro";
import { newExpansionBudget } from "./parts";
import { BASE_CSS, generateCss, missingLabel, pageCssText } from "./styles";

interface Props {
	/**
	 * The stored layout. Typed loosely on purpose: the caller is a site route
	 * whose entry data is generated by EmDash and never exactly `StoredBlock`.
	 * `deserializeEntry` validates and skips anything it cannot render.
	 */
	layout: unknown[] | null | undefined;
	styles?: unknown;
	content?: Array<{ _key: string; _type: string }> | null;
	header?: unknown;
	footer?: unknown;
	blocks?: unknown;
	/**
	 * Block types the site can render. A placed block of any other type shows
	 * "Missing component" in the builder's preview and nothing on the site.
	 * Omit to render every block.
	 */
	blockTypes?: readonly string[];
	/** Marks the markup for the builder's live preview (empty containers show). */
	edit?: boolean;
	/** The entry being rendered (marked on <main> for the editor). */
	entry?: { collection: string; id: string; slug?: string | null };
	/** Templates map: template ID → its stored layout and styles (for template_ref nodes). */
	templates?: Map<string, { layout: unknown[]; styles: unknown }>;
}

const { layout, styles, content, header, footer, blocks, blockTypes, edit = false, entry, templates } = Astro.props;


const { tree, pageCss } = deserializeEntry(layout as StoredBlock[] | null, styles as StoredStyles | null);
// Generated only from the tree's own nodes (never raw stored keys), validated;
// then the page's custom CSS, last so it can override.
const nodeCss = generateCss(tree, { edit }) + pageCssText(pageCss);
const contentBlocks = Array.isArray(content) ? content : [];
const byKey = new Map(contentBlocks.map((block) => [block._key, block]));

const referenced = new Set<string>();
const collect = (nodes: BuilderTree) => {
	for (const node of nodes) {
		if (node.type === "content_ref") referenced.add(String(node.props.ref_key));
		collect(node.children);
	}
};
collect(tree);
const unplaced = contentBlocks.filter((block) => !referenced.has(block._key));

const available = blockTypes ? new Set(blockTypes) : null;
// One expansion budget for the whole render (see BuilderNode's MAX_TEMPLATE_EXPANSIONS).
const shared = { blocks, byKey, available, edit, templates, budget: newExpansionBudget() };
const Header = header as any;
const Footer = footer as any;
const Blocks = blocks as any;
---

<div class="bd-layout" data-bd-root data-bd-edit={edit ? "" : undefined} style="display: contents">
	{Header && <Header />}
	<main
		data-bd-main
		class="builderdash"
		data-bd-id={entry?.id}
		data-bd-collection={entry?.collection}
		data-bd-slug={entry?.slug ?? undefined}
	>
		{tree.map((node) => <BuilderNode node={node} {...shared} />)}
		{
			Blocks &&
				unplaced.map((block) =>
					available && !available.has(block._type) ? (
						edit && <div class="bd-element" data-bd-ref={block._key} data-bd-missing={missingLabel(block._type)} />
					) : (
						<div class="bd-element" data-bd-ref={block._key}>
							<Blocks value={[block]} />
						</div>
					),
				)
		}
	</main>
	{Footer && <Footer />}
</div>

{/* The editor replaces this with its own live copy: see LiveCanvas. */}
<style id="bd-styles" set:html={nodeCss}></style>

{/* Base layout styles, shared with the editor's blob canvas (see `BASE_CSS`). */}
<style is:global set:html={BASE_CSS}></style>
